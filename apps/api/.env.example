# API
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://swipster:swipster@localhost:5432/swipster?schema=public

# Auth
JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=7d

# Email (OTP)
# For V1 you can start with SMTP or console logging.
EMAIL_FROM=no-reply@swipster.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Limits (fallbacks if AppSettings not set)
MAX_SWIPES_PER_DAY=20
MAX_SKIPS_PER_DAY=3
CREDITS_PER_DAY=100
